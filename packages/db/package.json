{
  "name": "@okf/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Database schema, migrations, client and job queue",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate-cli.ts",
    "seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts",
    "build": "node ../../scripts/bundle.mjs src/migrate-cli.ts dist/migrate.js"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}

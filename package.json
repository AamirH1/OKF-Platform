{
  "name": "okf-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Catalog, validate, version, query and share Open Knowledge Format (OKF) bundles.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w @okf/api",
    "dev:worker": "npm run dev -w @okf/worker",
    "dev:web": "npm run dev -w @okf/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck -w @okf/web",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "npm run generate -w @okf/db",
    "db:migrate": "npm run migrate -w @okf/db",
    "db:seed": "node scripts/seed.mjs",
    "openapi": "npm run openapi -w @okf/api",
    "check": "bash scripts/check.sh",
    "fixtures:large": "node scripts/generate-large-fixture.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}

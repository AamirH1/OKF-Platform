# OKF Platform environment. Copy to `.env` and adjust.
# docker compose also reads this file for the *_PORT variables.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development            # development | test | production
LOG_LEVEL=info                  # fatal|error|warn|info|debug|trace|silent

# --- API ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3000  # browser origin: CORS allow-list, links in emails, MinIO CORS
TRUST_PROXY=false               # true when behind a load balancer that sets X-Forwarded-For
# Where the Next.js server proxies /api/* (server-side only).
API_INTERNAL_URL=http://localhost:4000

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_PORT=5432
DATABASE_URL=postgres://okf:okf@localhost:5432/okf
DATABASE_POOL_MAX=10
# Used by integration/E2E tests (created by scripts/docker/postgres-init.sql).
TEST_DATABASE_URL=postgres://okf:okf@localhost:5432/okf_test

# --- Redis (distributed rate limiting) ---------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Object storage (S3 API: MinIO locally, S3/GCS in production) ------------
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000        # empty for AWS S3
S3_PUBLIC_ENDPOINT=http://localhost:9000 # endpoint browsers use for presigned URLs; empty = S3_ENDPOINT
S3_REGION=us-east-1
S3_BUCKET=okf-datasets
S3_ACCESS_KEY_ID=okfminio               # dev only; use IAM/HMAC credentials in production
S3_SECRET_ACCESS_KEY=okfminio-secret    # dev only
S3_FORCE_PATH_STYLE=true                # true for MinIO; false for AWS S3 virtual-hosted style

# --- Sessions ----------------------------------------------------------------
SESSION_TTL_HOURS=168
COOKIE_SECURE=auto              # auto = Secure cookies when NODE_ENV=production

# --- Email (password reset, invitations). Mailpit UI: http://localhost:8025 --
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM="OKF Platform <no-reply@okf.local>"

# --- Uploads -----------------------------------------------------------------
UPLOAD_MAX_BYTES=1073741824     # 1 GiB per archive
UPLOAD_PART_SIZE_BYTES=8388608  # 8 MiB multipart part size (min 5 MiB)
UPLOAD_SESSION_TTL_HOURS=24     # incomplete multipart uploads are aborted after this

# --- Safe extraction limits --------------------------------------------------
EXTRACT_MAX_FILES=20000
EXTRACT_MAX_TOTAL_BYTES=2147483648  # 2 GiB uncompressed
EXTRACT_MAX_FILE_BYTES=52428800     # 50 MiB per file
EXTRACT_MAX_RATIO=200               # max uncompressed/compressed ratio (zip-bomb guard)
EXTRACT_MAX_DEPTH=32                # max directory depth

# --- Malware scanning --------------------------------------------------------
MALWARE_SCANNER=none            # none | clamav (docker compose --profile security up -d)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Import from URL (SSRF-guarded, runs in the worker) ----------------------
IMPORT_ALLOWED_HOSTS=           # optional comma-separated allow-list, e.g. github.com,codeload.github.com
IMPORT_ALLOW_HTTP=false
IMPORT_ALLOW_PRIVATE_NETWORKS=false  # never enable in production
IMPORT_MAX_BYTES=536870912
IMPORT_TIMEOUT_MS=120000

# --- Query engine (DuckDB) ---------------------------------------------------
QUERY_CACHE_DIR=.cache/query
QUERY_TIMEOUT_MS=5000
QUERY_MAX_ROWS=1000
QUERY_MEMORY_LIMIT=512MB
QUERY_CACHE_ENTRIES=16

# --- Worker ------------------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=1000
WORKER_TEMP_DIR=                # empty = OS temp dir
WORKER_HEARTBEAT_MS=5000
WORKER_STALE_AFTER_MS=60000     # jobs without heartbeat this long are re-queued

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_MAX=300              # requests per window per user/API key/IP
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10          # login/signup/reset attempts per window per IP

# --- Observability -----------------------------------------------------------
METRICS_TOKEN=                  # if set, /metrics requires "Authorization: Bearer <token>"
